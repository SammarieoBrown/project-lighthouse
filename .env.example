# Project Lighthouse — environment template
#
# Copy to .env and fill in. NEVER put real credentials in this file: .env is
# gitignored, .env.example is committed. Adding a variable? Add it here too,
# with a placeholder, so a clean clone knows it exists.
#
# Setup runbook: docs/engineering/lighthouse-environment-setup.md

# ---------------------------------------------------------------------------
# Database — Neon serverless Postgres
# Requires PostGIS and pgvector; the initial migration CREATEs both extensions.
# ---------------------------------------------------------------------------
DATABASE_URL=postgresql://USER:PASSWORD@HOST.neon.tech/DBNAME?sslmode=require

# asyncpg rejects libpq's `sslmode`. Use `ssl=require` for the async driver.
DATABASE_URL_ASYNC=postgresql+asyncpg://USER:PASSWORD@HOST.neon.tech/DBNAME?ssl=require

# Neon pooled endpoint (`-pooler` on the endpoint ID) if connection limits bite.
# DATABASE_URL_POOLED=postgresql://USER:PASSWORD@HOST-pooler.neon.tech/DBNAME?sslmode=require

# Neon control-plane API. Used to create a throwaway branch per CI run and to
# cut a dev branch locally, since there is no local Postgres — no stock image
# ships PostGIS and pgvector together. The same two values are set as GitHub
# Actions secrets; keep them in step.
NEON_API_KEY=napi_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
NEON_PROJECT_ID=purple-dew-32786091

# ---------------------------------------------------------------------------
# Twilio — WhatsApp sandbox + SMS (demo path)
# ---------------------------------------------------------------------------
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=
TWILIO_WHATSAPP_FROM=whatsapp:+14155238886
TWILIO_SANDBOX_JOIN_CODE=join your-code-here
TWILIO_SMS_FROM=+1XXXXXXXXXX
TWILIO_SANDBOX_PARTICIPANTS=

# ---------------------------------------------------------------------------
# Meta WhatsApp Cloud API (production path)
# ---------------------------------------------------------------------------
META_WHATSAPP_TOKEN=
META_WHATSAPP_PHONE_NUMBER_ID=
META_WHATSAPP_VERIFY_TOKEN=

# ---------------------------------------------------------------------------
# Models
# ---------------------------------------------------------------------------
ANTHROPIC_API_KEY=

# ---------------------------------------------------------------------------
# Media storage (Cloudflare R2)
# ---------------------------------------------------------------------------
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=lighthouse-media

# ---------------------------------------------------------------------------
# Basemap hosting (Cloudflare R2, public bucket)
# ---------------------------------------------------------------------------
# The PMTiles archives are 138 MB of fetched-not-committed build output, so they
# cannot ride along in the repo and cannot be built on Vercel. They live in a
# public R2 bucket instead, which serves HTTP Range natively — the single
# requirement that makes a 98 MB archive cost 16 KB to open.
#
# Publish them with data/tiles/upload_basemap.sh after fetch_basemap.py.
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=
R2_TILES_BUCKET=lighthouse-tiles

# Read in the browser, hence NEXT_PUBLIC_. Not a secret: the bucket holds ODbL
# basemap tiles and is deliberately world-readable. Must also be set in Vercel
# for production and preview, or the console falls back to the static SVG map.
NEXT_PUBLIC_TILES_URL=

# ---------------------------------------------------------------------------
# App
# ---------------------------------------------------------------------------
ENVIRONMENT=local
LOG_LEVEL=INFO
PUBLIC_BASE_URL=http://localhost:8000
REPLAY_SEED=20251028
