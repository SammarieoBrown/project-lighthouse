# python
__pycache__/
*.py[cod]
.venv/
venv/
.env
.env.*
!.env.example
# node
node_modules/
.next/
dist/
next-env.d.ts
*.tsbuildinfo

# browser-automation scratch output
.playwright-mcp/
.playwright-cli/

# Map tiles are staged into the console's public dir at build time from
# data/tiles/cache, which is the checksummed copy. Two copies in git would
# double the repo for no gain, and the staged one has no manifest.
apps/console/public/tiles/
apps/console/.tiles/
apps/console/public/maplibre/

# Map archives are large fetched or derived artifacts, so they are not
# committed. Basemap bytes are pinned by data/tiles/cache/manifest.sha256; the
# structures build has its separate committed provenance manifest at
# data/tiles/structures.manifest.json. The point is that a local/published copy
# matches reviewed provenance, not that git carries the archive itself.
data/tiles/cache/*.pmtiles
data/tiles/cache/structures-build.mbtiles*
# os / editor
.DS_Store
.idea/
.vscode/
# data & secrets
*.pem
*.key

# NOTE: data/replay/cache/ is deliberately NOT ignored. The Melissa advisory
# cache is committed so the replay is byte-identical on every machine and on
# the demo laptop. Regenerate with data/replay/fetch_advisories.py and check it
# against the manifest. Never commit real household data here.

# python build artefacts
*.egg-info/
.pytest_cache/
.vercel
.env*.local

# Building footprints: 232 MB of fetched-not-committed reference data. Unlike
# the storm advisories, no replay has to reproduce this byte-for-byte on a demo
# laptop. DuckDB aggregates it during the inventory build; Postgres stores only
# the resulting place and exposure counts.
# Rebuild with data/buildings/fetch_footprints.py
data/buildings/cache/*.parquet

# Large structures-build intermediates are regenerable and content-verified by
# the adjacent ignored build-state record before they are reused.
data/buildings/cache/*.geojsonl
data/buildings/cache/structure-points.geojsonl
